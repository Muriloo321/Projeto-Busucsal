# ============================================================================
# BusUCSAL — variáveis de ambiente (exemplo SEM credenciais reais)
# Crie o seu .env com segredos aleatórios:   npm run configurar
# (ou copie este arquivo para .env e troque todos os valores "troque-...").
# O servidor se recusa a iniciar com os valores de exemplo.
# ============================================================================

NODE_ENV=development
PORT=3000
# 127.0.0.1 = só este computador. Use 0.0.0.0 para abrir em outro aparelho da mesma rede.
HOST=127.0.0.1
APP_TIMEZONE=America/Bahia

# --- Banco de dados (Docker Compose usa POSTGRES_PASSWORD) -------------------
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgres://busucsal:troque-esta-senha@localhost:5432/busucsal
DATABASE_URL_TEST=postgres://busucsal:troque-esta-senha@localhost:5432/busucsal_test

# --- Rastreador (Traccar Client / simuladores) -------------------------------
# Identificadores aceitos em POST /api/posicao (separados por vírgula). O primeiro é o ônibus exibido.
TRACKER_DEVICE_IDS=busucsal-01
DEVICE_TOKEN=troque-por-um-token-aleatorio

# --- Segredos do servidor ------------------------------------------------------
ADMIN_SESSION_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres
SESSION_HASH_SECRET=troque-por-outro-segredo-aleatorio-de-32-caracteres
# Opcional: token para outros serviços internos chamarem GET /api/estado (cabeçalho X-Internal-Token)
INTERNAL_API_TOKEN=

# --- Acesso e demonstração -----------------------------------------------------
# Permite que aparelhos da rede local (ex.: celular no mesmo Wi-Fi) abram a apresentação.
INTERNAL_ALLOW_PRIVATE_NETWORK=false
# Ativa cenários de demonstração e o simulador GPS integrado. Use false fora de apresentações.
DEMO_MODE=true
# true quando servido por HTTPS
COOKIE_SECURE=false
ADMIN_SESSION_HOURS=8
BCRYPT_ROUNDS=12

# --- Regras de negócio (valores iniciais da Seção 4; calibrar com dados reais) ---
STALE_POSITION_SECONDS=180
STOPPED_MINUTES=5
SPEED_WINDOW_MINUTES=5
ETA_MIN_SPEED_KMH=10
STOPPED_SPEED_KMH=3
ARRIVAL_RADIUS_M=50
ROUTE_MATCH_TOLERANCE_M=150
ROUTE_BACKTRACK_TOLERANCE_M=80
STOP_ROUTE_TOLERANCE_M=100
CLASSIFIER_TIMEOUT_MS=2000
CHAT_SESSION_HOURS=24

# --- Simulador GPS integrado e métricas -----------------------------------------
SIMULATOR_INTERVAL_SECONDS=30
METRICS_FILE=data/metricas.json
